{
  "name": "careermatch-server",
  "version": "1.0.0",
  "description": "CareerMatch Express API Server",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --experimental-vm-modules %INIT_CWD%/../../node_modules/.bin/jest --forceExit --testPathPattern __tests__",
    "lint": "eslint src/ --ext .js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "mammoth": "^1.8.0",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.3.1"
  },
  "jest": {
    "rootDir": ".",
    "roots": ["<rootDir>/__tests__", "<rootDir>/src"],
    "transform": {},
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "moduleFileExtensions": ["js", "json"]
  }
}
